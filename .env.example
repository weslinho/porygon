# Token do bot (Discord Developer Portal > Bot > Token)
PORYGON_TOKEN=

# Credenciais do Firebase Realtime Database, como JSON em UMA linha.
# Exemplo de formato (use os dados do seu projeto):
# FIREBASE_CREDENTIALS={"apiKey":"...","authDomain":"...","databaseURL":"https://SEU-PROJETO-default-rtdb.firebaseio.com","projectId":"..."}
FIREBASE_CREDENTIALS=

# Intents do Discord repassadas ao discord.js (valor único, ver README).
INTENTS=

# IDs de usuários do Discord com acesso aos comandos de dono, separados por espaço.
# Cuidado: quem estiver aqui pode usar o comando "eval".
ACESS=

# ID do servidor onde o bot atua (o bot ignora os demais).
GUILD_ID=

# ID do canal de logs privados (reações com emojis proibidos).
PRIVATE_LOG_CHANNEL_ID=

# ID do canal de logs de moderação (silenciamentos).
MOD_LOG_CHANNEL_ID=

# ID do canal usado por padrão no comando "stats".
STATS_CHANNEL_ID=
